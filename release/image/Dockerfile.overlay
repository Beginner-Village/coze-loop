# Overlay build for customer POC: take the customer's legacy image as base,
# replace the binary with the obs-2026-04-29 build (file_writer support), and
# bridge the env-name mismatch between customer deployment (YNET_LOOP_*) and
# the obs binary (still reads COZE_LOOP_*).

FROM golang:1.24-alpine AS backend_builder

ENV GOPROXY=https://goproxy.cn,direct
RUN apk add --no-cache git
WORKDIR /coze-loop
COPY ./backend/go.mod ./backend/go.sum /coze-loop/src/backend/
RUN go mod download -C ./src/backend -x
COPY ./backend/ /coze-loop/src/backend/
RUN mkdir -p ./bin && \
    go -C /coze-loop/src/backend build -buildvcs=false -o /coze-loop/bin/main "./cmd"

# Conf patcher: rebrand host names from cozeloop-* → ynet-loop-* so the
# customer's patch-conf init container (sed keyed on ynet-loop-*) keeps
# working.
FROM alpine:3.22.0 AS conf_patcher
COPY ./release/deployment/helm-chart/umbrella/conf /work
RUN cd /work && \
    find . -name '*.yaml' -exec sed -i \
      -e 's|cozeloop-redis|ynet-loop-redis|g' \
      -e 's|cozeloop-mysql|ynet-loop-mysql|g' \
      -e 's|cozeloop-minio|ynet-loop-minio|g' \
      -e 's|cozeloop-namesrv|ynet-loop-rmq-namesrv|g' \
      -e 's|cozeloop-clickhouse|ynet-loop-clickhouse|g' \
      -e 's|cozeloop_evaluation_expt_turn_result_filter|ynetloop_evaluation_expt_turn_result_filter|g' \
      {} \;

# Final: customer's legacy image with swapped binary + patched conf + env
# bridge script.
FROM harbor.ynet.io:8000/bbw-poc-ai/ynet-loop/app:legacy-good

COPY --from=backend_builder /coze-loop/bin/main /ynet-loop/bin/main
COPY --from=conf_patcher /work /ynet-loop/conf

# Rewrite entrypoint.sh so it re-exports YNET_LOOP_* env vars as COZE_LOOP_*
# before launching the binary (which reads COZE_LOOP_* names on this branch).
RUN cat > /ynet-loop/bootstrap/entrypoint.sh <<'ENTRYPOINT_EOF' && \
    chmod +x /ynet-loop/bootstrap/entrypoint.sh
#!/bin/sh
exec 2>&1
set -e

print_banner() {
  msg="$1"
  side=30
  content=" $msg "
  content_len=${#content}
  line_len=$((side * 2 + content_len))
  line=$(printf '*%.0s' $(seq 1 "$line_len"))
  side_eq=$(printf '*%.0s' $(seq 1 "$side"))
  printf "%s\n%s%s%s\n%s\n" "$line" "$side_eq" "$content" "$side_eq" "$line"
}

print_banner "Starting..."

export ROCKETMQ_GO_LOG_LEVEL=error

# Bridge: customer deployment sets YNET_LOOP_*, binary reads COZE_LOOP_*.
for v in $(env | grep -E '^YNET_LOOP_' | cut -d= -f1); do
  val=$(printenv "$v")
  new=$(echo "$v" | sed 's|^YNET_LOOP_|COZE_LOOP_|')
  export "$new=$val"
done

(
  while true; do
    if sh /ynet-loop/bootstrap/healthcheck.sh; then
      print_banner "Completed!"
      break
    else
      sleep 1
    fi
  done
)&

/ynet-loop/bin/main
ENTRYPOINT_EOF
